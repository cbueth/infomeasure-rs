#
# Cross-package benchmark image.
#
# Extends the CI toolchain image with the third-party packages used for runtime
# comparison: JIDT (Java), PyInform / dit / pyitlib / pyentrp / Syntropy
# (Python), RTransferEntropy (R), and DiscreteEntropy.jl (Julia).
#
# Pins are NOT hardcoded here: they come from the benchmark registry on the
# `pages` branch (`registry.json`), expanded by
# `scripts/bench_packages/sync_pins.py` into `.pins/requirements.txt` and
# `.pins/pins.env`, which this build copies in. CI checks out `pages`, runs the
# sync, then builds. Locally:
#   python scripts/bench_packages/sync_pins.py --registry <pages>/registry.json
#   docker build -f .docker/Dockerfile.bench -t im-bench:dev .
# Publish tag: codeberg.org/cbueth/infomeasure-rs:bench

FROM codeberg.org/cbueth/infomeasure-rs:stable

ENV DEBIAN_FRONTEND=noninteractive

# Registry-derived pins (see header).
COPY .pins/ /opt/pins/

# --- JDK (JIDT) + R + headers needed to compile RTransferEntropy/Rcpp -------
RUN set -eux; set -a; . /opt/pins/pins.env; set +a; \
    apt-get update && apt-get install -y --no-install-recommends \
        "$JDK_PACKAGE" \
        r-base-core \
        r-base-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# --- JIDT (version- and sha256-pinned from the registry) --------------------
ENV JIDT_JAR=/opt/jidt/infodynamics.jar
RUN set -eux; set -a; . /opt/pins/pins.env; set +a; \
    mkdir -p /opt/jidt; \
    curl -fsSL -o /tmp/jidt.zip \
        "https://lizier.me/joseph/software/jidt/download.php?file=infodynamics-dist-${JIDT_VERSION}.zip"; \
    unzip -q /tmp/jidt.zip -d /tmp/jidt-extract; \
    cp "$(find /tmp/jidt-extract -name 'infodynamics.jar' | head -n1)" "${JIDT_JAR}"; \
    echo "${JIDT_JAR_SHA256}  ${JIDT_JAR}" | sha256sum -c -; \
    rm -rf /tmp/jidt.zip /tmp/jidt-extract

# Compile a tiny JIDT smoke program (real KSG compute, not an import check).
COPY .docker/bench-jidt-smoke.java /opt/jidt-smoke/JidtSmoke.java
RUN javac -cp "${JIDT_JAR}" -d /opt/jidt-smoke /opt/jidt-smoke/JidtSmoke.java

# --- Bench Python env from pinned requirements ------------------------------
ENV BENCH_VENV=/opt/bench-venv
RUN set -eux; \
    uv venv "${BENCH_VENV}" --python python3; \
    uv pip install --python "${BENCH_VENV}/bin/python" -r /opt/pins/requirements.txt

# --- Julia (pinned runtime + package versions) ------------------------------
ENV JULIA_DEPOT_PATH=/opt/julia-depot
ENV PATH=/opt/julia/bin:${PATH}
RUN set -eux; set -a; . /opt/pins/pins.env; set +a; \
    julia_mm="$(echo "$JULIA_VERSION" | cut -d. -f1,2)"; \
    curl -fsSL -o /tmp/julia.tar.gz \
        "https://julialang-s3.julialang.org/bin/linux/x64/${julia_mm}/julia-${JULIA_VERSION}-linux-x86_64.tar.gz"; \
    echo "${JULIA_SHA256}  /tmp/julia.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/julia.tar.gz -C /opt; \
    mv "/opt/julia-${JULIA_VERSION}" /opt/julia; \
    rm -f /tmp/julia.tar.gz; \
    julia --version; \
    julia -e 'using Pkg; Pkg.add([Pkg.PackageSpec(name="DiscreteEntropy", version=ENV["JULIA_PKG_DISCRETEENTROPY"]), Pkg.PackageSpec(name="JSON", version=ENV["JULIA_PKG_JSON"])]); Pkg.precompile()'; \
    chmod -R a+rX /opt/julia /opt/julia-depot

# --- R from a pinned CRAN snapshot ------------------------------------------
RUN set -eux; set -a; . /opt/pins/pins.env; set +a; \
    Rscript -e "install.packages('RTransferEntropy', repos=Sys.getenv('R_CRAN_SNAPSHOT'))"

COPY .docker/bench-smoke.sh /usr/local/bin/bench-smoke
RUN chmod +x /usr/local/bin/bench-smoke

WORKDIR /build
CMD ["bash"]
