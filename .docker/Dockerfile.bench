#
# Cross-package benchmark image.
#
# Extends the CI toolchain image with the third-party packages used for runtime
# comparison: JIDT (Java), PyInform / dit / pyitlib / pyentrp / Syntropy /
# NPEET-free (Python), RTransferEntropy (R), and DiscreteEntropy.jl (Julia).
#
# Build on the CI runner (dev tag, no registry push):
#   docker build -f .docker/Dockerfile.bench -t im-bench:dev .
# Publish tag: codeberg.org/cbueth/infomeasure-rs:bench

FROM codeberg.org/cbueth/infomeasure-rs:stable

ENV DEBIAN_FRONTEND=noninteractive

# --- JDK (JIDT) + R + headers needed to compile RTransferEntropy/Rcpp -------
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        r-base-core \
        r-base-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# --- JIDT (version- and checksum-pinned; see benches/packages.lock) ----------
ARG JIDT_VERSION=1.6.1
ARG JIDT_JAR_SHA256=2d367c244b729877fdaf0608884cf97ae964a8035c3020215b799812143a5b11
ENV JIDT_JAR=/opt/jidt/infodynamics.jar
RUN set -eux; \
    mkdir -p /opt/jidt; \
    curl -fsSL -o /tmp/jidt.zip \
        "https://lizier.me/joseph/software/jidt/download.php?file=infodynamics-dist-${JIDT_VERSION}.zip"; \
    unzip -q /tmp/jidt.zip -d /tmp/jidt-extract; \
    cp "$(find /tmp/jidt-extract -name 'infodynamics.jar' | head -n1)" "${JIDT_JAR}"; \
    echo "${JIDT_JAR_SHA256}  ${JIDT_JAR}" | sha256sum -c -; \
    rm -rf /tmp/jidt.zip /tmp/jidt-extract

# Compile a tiny JIDT smoke program (real KSG compute, not an import check).
COPY .docker/bench-jidt-smoke.java /opt/jidt-smoke/JidtSmoke.java
RUN javac -cp "${JIDT_JAR}" -d /opt/jidt-smoke /opt/jidt-smoke/JidtSmoke.java

# --- Bench Python env, separate from the validation venv --------------------
ENV BENCH_VENV=/opt/bench-venv
RUN set -eux; \
    uv venv "${BENCH_VENV}" --python python3; \
    uv pip install --python "${BENCH_VENV}/bin/python" \
        numpy scipy infomeasure pyinform dit pyitlib pyentrp "syntropyx==0.0.2"

# --- Julia + DiscreteEntropy.jl (natural home of discrete estimators) --------
ARG JULIA_VERSION=1.12.7
ARG JULIA_SHA256=4e7e9e776634d24835250de67cde39b0d4af15bc432eb20697e6be6c28ea69e8
ENV JULIA_DEPOT_PATH=/opt/julia-depot
ENV PATH=/opt/julia/bin:${PATH}
RUN set -eux; \
    curl -fsSL -o /tmp/julia.tar.gz \
        "https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-${JULIA_VERSION}-linux-x86_64.tar.gz"; \
    echo "${JULIA_SHA256}  /tmp/julia.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/julia.tar.gz -C /opt; \
    mv "/opt/julia-${JULIA_VERSION}" /opt/julia; \
    rm -f /tmp/julia.tar.gz; \
    julia --version; \
    julia -e 'using Pkg; Pkg.add(["DiscreteEntropy", "JSON"]); Pkg.precompile()'; \
    chmod -R a+rX /opt/julia /opt/julia-depot

# --- RTransferEntropy (compiles Rcpp; toolchain is present in the base) -----
RUN Rscript -e 'install.packages("RTransferEntropy", repos="https://cloud.r-project.org")'

COPY .docker/bench-smoke.sh /usr/local/bin/bench-smoke
RUN chmod +x /usr/local/bin/bench-smoke

WORKDIR /build
CMD ["bash"]
